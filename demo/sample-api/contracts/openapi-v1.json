  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderCreate": {
        "properties": {
          "user_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "User Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemCreate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "Optional customer notes"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "items"
        ],
        "title": "OrderCreate"
      },
      "OrderItemCreate": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemCreate"
      },
      "OrderItemResponse": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Unit Price",
            "description": "Price per unit at purchase time"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity",
          "unit_price"
        ],
        "title": "OrderItemResponse"
      },
      "OrderListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "OrderListResponse"
      },
      "OrderResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total_amount": {
            "type": "number",
            "title": "Total Amount"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "status",
          "items",
          "total_amount",
          "created_at"
        ],
        "title": "OrderResponse"
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "shipped",
          "delivered",
          "cancelled"
        ],
        "title": "OrderStatus"
      },
      "OrderUpdateStatus": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "Target status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "OrderUpdateStatus"
      },
      "PaymentCreate": {
        "properties": {
          "order_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Order Id"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethod",
            "default": "credit_card"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "amount"
        ],
        "title": "PaymentCreate"
      },
      "PaymentMethod": {
        "type": "string",
        "enum": [
          "credit_card",
          "debit_card",
          "paypal",
          "crypto"
        ],
        "title": "PaymentMethod"
      },
      "PaymentReceiptResponse": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "title": "Receipt Id"
          },
          "payment_id": {
            "type": "integer",
            "title": "Payment Id"
          },
          "amount": {
            "type": "number",
