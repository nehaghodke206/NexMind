# Dependency Guardian Backend Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Base
API_PREFIX=/api/v1

# Database Configuration
# PostgreSQL (configured local development and production):
DATABASE_URL=postgresql+psycopg://root:your_password@localhost:5432/hackwave

# Optional individual connection parameters (alternative to DATABASE_URL):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=root
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=hackwave

# SQLite fallback for standalone zero-config testing:
# DATABASE_URL=sqlite:///./dependency_guardian.db


# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
