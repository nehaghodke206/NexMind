# Dependency Guardian Centralized Environment Configuration

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./dependency_guardian.db

# Shared Agent Configuration
BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
BACKEND_TIMEOUT_SECONDS=10.0

# Local AI / Ollama Inference Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=30.0

# General Request Timeout Fallback
REQUEST_TIMEOUT_SECONDS=10.0

# Frontend API URL
# Example for Vite: VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
