
erDiagram
    USERS {
        int id PK
        string name
        string email UK
        string external_auth_id UK
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    PROJECTS {
        int id PK
        string name
        text description
        string repository_url
        string repository_root_name
        string default_branch
        string last_scanned_revision
        int created_by FK
        json settings_json
        datetime created_at
        datetime updated_at
    }

    DEPENDENCIES {
        int id PK
        int project_id FK
        string name
        string base_url
        string http_method
        string endpoint_path
        string environment
        json config_json
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    BASELINE_VERSIONS {
        int id PK
        int dependency_id FK
        int version_number
        json schema_json
        json sample_response_json
        string content_hash
        int created_by FK
        boolean is_active
        datetime created_at
        text notes
    }

    SCAN_RUNS {
        int id PK
        int project_id FK
        int dependency_id FK
        int baseline_version_id FK
        int triggered_by FK
        string scan_type
        string repository_revision
        string scanner_version
        string trigger_type
        string status
        datetime started_at
        datetime finished_at
        json summary_json
        text error_message
        datetime created_at
    }

    REPOSITORY_NODES {
        int id PK
        int project_id FK
        int scan_run_id FK
        string node_type
        string stable_key
        string name
        string relative_path
        int start_line
        int end_line
        json metadata_json
        datetime created_at
    }

    REPOSITORY_EDGES {
        int id PK
        int project_id FK
        int scan_run_id FK
        int source_node_id FK
        int target_node_id FK
        string edge_type
        float confidence
        json evidence_json
        datetime created_at
    }

    INCIDENTS {
        int id PK
        int dependency_id FK
        int assignee_id FK
        string title
        text description
        string change_type
        string severity
        string status
        string fingerprint
        datetime first_detected_at
        datetime last_observed_at
        datetime resolved_at
        text evidence_summary
        json metadata_json
        datetime created_at
        datetime updated_at
    }

    REPAIR_PROPOSALS {
        int id PK
        int incident_id FK
        int proposed_by FK
        string title
        text rationale
        string patch_format
        text patch_content
        string target_ref
        string base_revision
        json target_file_paths_json
        string patch_hash
        string status
        json validation_summary_json
        string applied_revision
        datetime applied_at
        datetime created_at
        datetime updated_at
    }

    VALIDATION_RUNS {
        int id PK
        int repair_id FK
        int run_number
        string status
        string validator_type
        string input_revision
        json results_json
        string logs_uri
        text error_message
        datetime started_at
        datetime finished_at
        datetime created_at
    }

    USERS ||--o{ PROJECTS : creates
    PROJECTS ||--o{ DEPENDENCIES : monitors
    DEPENDENCIES ||--o{ BASELINE_VERSIONS : has

    PROJECTS ||--o{ SCAN_RUNS : scanned_by
    DEPENDENCIES o|--o{ SCAN_RUNS : checked_in
    BASELINE_VERSIONS o|--o{ SCAN_RUNS : used_by
    USERS o|--o{ SCAN_RUNS : triggers
    USERS o|--o{ BASELINE_VERSIONS : captures

    SCAN_RUNS ||--o{ REPOSITORY_NODES : discovers
    SCAN_RUNS ||--o{ REPOSITORY_EDGES : maps
    PROJECTS ||--o{ REPOSITORY_NODES : contains
    PROJECTS ||--o{ REPOSITORY_EDGES : contains
    REPOSITORY_NODES ||--o{ REPOSITORY_EDGES : source
    REPOSITORY_NODES ||--o{ REPOSITORY_EDGES : target

    DEPENDENCIES ||--o{ INCIDENTS : produces
    USERS o|--o{ INCIDENTS : assigned_to
    INCIDENTS ||--o{ REPAIR_PROPOSALS : has
    USERS o|--o{ REPAIR_PROPOSALS : proposes
    REPAIR_PROPOSALS ||--o{ VALIDATION_RUNS : validated_by
